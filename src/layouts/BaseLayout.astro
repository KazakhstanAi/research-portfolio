---
import "../styles/global.css";
import "../styles/projects.css";
import ProjectNav from "../components/ProjectNav.astro";
import { projects } from "../data/projects";
interface Props { lang: "en" | "ru"; title: string; description: string; canonicalPath: string; }
const { lang, title, description, canonicalPath } = Astro.props;
const ru = lang === "ru";
const home = ru ? "/ru" : "/";
const alternatePath = ru ? canonicalPath.replace(/^\/ru/, "") || "/" : "/ru" + (canonicalPath === "/" ? "" : canonicalPath);
const origin = Astro.site;
const theme = projects.find(project => canonicalPath.endsWith(project.path))?.id ?? "portfolio";
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#f5f3ec" />
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  {origin && <><link rel="canonical" href={new URL(canonicalPath, origin)} /><link rel="alternate" hreflang={ru ? "en" : "ru"} href={new URL(alternatePath, origin)} /></>}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content="Vais Research" />
  <title>{title}</title>
</head>
<body data-project={theme}>
  <a class="skip" href="#main">{ru ? "К содержанию" : "Skip to content"}</a>
  <header class="header wrap">
    <a href={home} class="brand"><svg viewBox="0 0 32 32" width="30" height="30" fill="none" aria-hidden="true"><path d="M3 6L14 27H18L29 6H24L16 21L8 6Z" fill="currentColor"/><path d="M14 6H19L16.5 11Z" fill="#bb593e"/></svg><span>Vais Research</span></a>
    <nav aria-label={ru ? "Навигация" : "Navigation"}>
      <a href={home + "#projects"}>{ru ? "Проекты" : "Projects"}</a>
      <a href={home + "#reading"}>{ru ? "Материалы" : "Reading"}</a>
      <a href={home + "#about"}>{ru ? "Об авторе" : "About"}</a>
      <a class="nav-github" href="https://github.com/MataVsn">GitHub ↗</a>
      <a href={alternatePath} lang={ru ? "en" : "ru"} hreflang={ru ? "en" : "ru"} class="lang">{ru ? "EN" : "RU"}</a>
    </nav>
  </header>
  <ProjectNav lang={lang} path={canonicalPath} />
  <main id="main"><slot /></main>
  <footer class="footer wrap">
    <div><a class="footer-brand" href={home}>Vais Research</a><p>© 2026 · {ru ? "Исследовательское портфолио VAIS Labs" : "The VAIS Labs research portfolio"}</p></div>
    <nav aria-label={ru ? "Все проекты" : "All projects"}>{projects.map(project => <a href={(ru ? "/ru" : "") + project.path}>{project.name}</a>)}</nav>
    <nav aria-label={ru ? "Приложения" : "Applications"}>{projects.filter(project => project.app).map(project => <a href={project.app!}>{project.name} ↗</a>)}</nav>
  </footer>
</body>
</html>
