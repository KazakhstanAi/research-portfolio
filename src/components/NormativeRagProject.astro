---
import BaseLayout from "../layouts/BaseLayout.astro";
import NormativeRagArtwork from "./NormativeRagArtwork.astro";
import { normativeRag as project } from "../data/normative-rag";
import { researchDirections } from "../data/research-directions";
import "../styles/normative-rag.css";
interface Props { locale: "en" | "ru"; }
const { locale } = Astro.props;
const ru = locale === "ru";
const l = ru ? 1 : 0;
const txt = (en: string, russian: string) => ru ? russian : en;
const prefix = ru ? "/ru" : "";
const adjacentReference = researchDirections["human-ai"].references.find(ref => ref.id === "complementarity")!;
const sections = [["gap",txt("Research Gap", "Исследовательский пробел")], ["questions",txt("Research Questions", "Исследовательские вопросы")], ["methodology",txt("Methodology", "Методология")], ["variables",txt("Experimental Variables", "Переменные эксперимента")], ["evaluation",txt("Behavioral Evaluation", "Оценка поведения")], ["contamination",txt("Contamination Experiment", "Смешивание корпуса")], ["contributions",txt("Expected Contributions", "Ожидаемый вклад")], ["related",txt("Related Research", "Связанные исследования")]];
---
<BaseLayout lang={locale} canonicalPath={prefix + "/projects/normative-rag"} title={project.title[l] + " | VAIS Labs"} description={project.description[l]} keywords={project.tags}>
  <div class="wrap normative-project">
    <div class="project-hero">
      <a class="text-link" href={(ru ? "/ru" : "/") + "#projects"}>← {txt("All projects", "Все проекты")}</a>
      <p class="eyebrow normative-kicker">Research / AI Safety / LLM Evaluation / RAG</p>
      <h1>{project.title[l]}</h1>
      <p class="lead">{project.description[l]}</p>
      <div class="project-meta"><span>{project.shortName}</span><span class="status">{txt("Research in progress", "Исследование в процессе")}</span><span>{txt("Experiments planned · results to be evaluated", "Эксперименты планируются · результаты предстоит оценить")}</span></div>
    </div>
    <figure class="project-cover normative-cover"><NormativeRagArtwork /><figcaption><span>NORMATIVE RAG / MORAL DRIFT</span><span>{txt("Conceptual comparison · not a measured behavioral shift", "Концептуальное сравнение · не измеренный сдвиг поведения")}</span></figcaption></figure>
    <div class="project-overview"><div><span>{txt("Normative environments", "Нормативные среды")}</span><strong>{txt("5 planned profiles", "5 планируемых профилей")}</strong></div><div><span>{txt("Action vocabulary", "Словарь действий")}</span><strong>STOP / CONTINUE / ESCALATE / REPORT / CONCEAL / DEFER</strong></div><div><span>{txt("Pilot target", "Ориентир пилота")}</span><strong>{txt("≈ 2,000–3,000 generations", "≈ 2 000–3 000 генераций")}</strong></div><div><span>{txt("Current evidence", "Текущие результаты")}</span><strong>{txt("To be evaluated", "Предстоит оценить")}</strong></div></div>
    <div class="article-grid"><nav class="toc" aria-label={txt("On this page", "На этой странице")}>{sections.map(([id,label]) => <a href={"#" + id}>{label}</a>)}</nav><div class="article">
      <section id="gap"><p class="eyebrow">01 / {txt("Research Gap", "Исследовательский пробел")}</p><h2>{txt("Retrieval as a normative environment.", "Retrieval как нормативная среда.")}</h2>
        <p>{txt("The project treats a retrieved knowledge base as an external normative environment. An otherwise identical LLM encounters the same management scenario, but retrieves documents that express different organizational values. Model weights remain fixed in the primary comparison.", "Проект рассматривает извлекаемую базу знаний как внешнюю нормативную среду. Одна и та же LLM получает одинаковый управленческий сценарий, но извлекает документы с различными организационными ценностями. В основном сравнении веса модели фиксированы.")}</p>
        <p>{txt("Company policies, compliance rules and organizational guidelines are the motivating context. The research asks whether corpus composition and retrieval ranking can influence an agent's effective decision policy alongside its weights and system prompt.", "Мотивирующий контекст — корпоративные политики, правила compliance и организационные инструкции. Исследование проверяет, могут ли состав корпуса и ранжирование retrieval влиять на фактическую политику решений агента вместе с его весами и system prompt.")}</p>
        <div class="note"><p>{txt("Working research gap: systematic normative influence introduced through retrieval, including policy–authority conflicts and controlled corpus contamination. The literature review is in progress; this is a research positioning hypothesis, not a verified claim that prior work is absent.", "Рабочий исследовательский пробел — систематическое нормативное влияние через retrieval, включая конфликты политик с управленческим давлением и контролируемое смешивание корпуса. Обзор литературы продолжается; это гипотеза позиционирования, а не подтверждённое утверждение об отсутствии предыдущих работ.")}</p></div>
        <p>{txt("Moral reasoning, ethical benchmarks, role prompting, value conditioning, adversarial prompting and normative conflict are the related-work directions to map. The intended distinction is where the normative influence enters: retrieved evidence rather than only direct prompt steering.", "В обзоре предстоит сопоставить моральное рассуждение, этические бенчмарки, role prompting, value conditioning, adversarial prompting и нормативные конфликты. Предполагаемое различие — источник нормативного влияния: извлечённые документы, а не только прямое управление через prompt.")}</p>
      </section>
      <section id="questions"><p class="eyebrow">02 / {txt("Research Questions", "Исследовательские вопросы")}</p><h2>{txt("Same model. Different retrieved values.", "Одна модель. Разные извлечённые ценности.")}</h2><div class="note"><p>{project.question[l]}</p></div><ol class="normative-questions">{project.questions.map(question => <li>{question[l]}</li>)}</ol></section>
      <section id="methodology"><p class="eyebrow">03 / {txt("Methodology", "Методология")}</p><h2>{txt("A controlled comparison of decisions.", "Контролируемое сравнение решений.")}</h2>
        <p>{txt("Evaluate candidate open-source LLM families in paired scenarios. For each model, keep the checkpoint, scenario, system prompt, action schema and generation settings fixed while changing the normative retrieval condition. Use neutral retrieval as the primary control; vary pressure and retrieval settings as explicit experimental factors.", "Оценить выбранные семейства открытых LLM на парных сценариях. Для каждой модели фиксировать checkpoint, сценарий, system prompt, схему действий и параметры генерации, изменяя нормативный retrieval. Основной контроль — нейтральное извлечение; давление и параметры retrieval изменяются как явные экспериментальные факторы.")}</p>
        <figure class="normative-diagram"><figcaption>{txt("Planned experiment / conceptual flow", "Планируемый эксперимент / концептуальная схема")}</figcaption><ol>{project.diagram.map((step,i) => <li><span>0{i+1}</span><strong>{step[l]}</strong></li>)}</ol></figure>
        <div class="normative-comparison" aria-label={txt("Controlled comparison", "Контролируемое сравнение")}><div><span class="eyebrow">{txt("Held fixed", "Фиксируется")}</span><strong>{txt("Same Model", "Одна модель")}</strong><strong>{txt("Same Scenario", "Один сценарий")}</strong></div><span class="comparison-arrow" aria-hidden="true">→</span><div><span class="eyebrow">{txt("Intervention", "Изменяется")}</span><strong>{txt("Different RAG Environment", "Разная RAG-среда")}</strong><p>Safety / Transparency / Profit / Authority / Neutral</p></div><span class="comparison-arrow" aria-hidden="true">→</span><div><span class="eyebrow">{txt("To be evaluated", "Предстоит оценить")}</span><strong>{txt("Different Decision?", "Другое решение?")}</strong></div></div>
        <h3>{txt("Normative environments", "Нормативные среды")}</h3><div class="normative-chips">{project.profiles.map(profile => <span>{profile}</span>)}</div>
        <h3>{txt("Value-conflict scenarios", "Сценарии конфликта ценностей")}</h3><ul>{project.conflicts.map(conflict => <li>{conflict[l]}</li>)}</ul>
        <h3>{txt("Authority pressure", "Управленческое давление")}</h3><div class="normative-chips">{project.pressure.map(level => <span>{level[l]}</span>)}</div>
        <h3>{txt("Technical architecture · planned", "Техническая архитектура · план")}</h3><div class="pipeline">{project.pipeline.map((step,i) => <div><span>0{i+1}</span><strong>{step[l]}</strong></div>)}</div>
        <p>{txt("Each generation selects one discrete action and provides a short explanation and confidence estimate. Define eligible actions and a scenario-specific rubric before evaluation. Log invalid or missing outputs separately. Explanations are observable reports, not access to a model's internal reasoning; self-reported confidence is not assumed to be calibrated.", "Каждая генерация выбирает дискретное действие и даёт краткое объяснение с оценкой уверенности. Допустимые действия и рубрика для сценария определяются до оценки. Невалидные и отсутствующие ответы логируются отдельно. Объяснение — наблюдаемый текст, а не доступ к внутреннему рассуждению модели; самооценка уверенности не предполагается калиброванной.")}</p><div class="normative-chips action-chips">{project.actions.map(action => <code>{action}</code>)}</div>
        <h3>{txt("Reproducible logging", "Воспроизводимое логирование")}</h3><div class="normative-log-fields">{project.logs.map(field => <span>{field}</span>)}</div><p class="small muted">{txt("Also version the corpus, retriever, ranking settings, prompt template and generation parameters. Preserve retrieved evidence so corpus contamination and actual retrieved exposure can be analyzed separately.", "Также версионируются корпус, retriever, параметры ранжирования, шаблон prompt и параметры генерации. Извлечённые документы сохраняются, чтобы отдельно анализировать долю смешивания корпуса и фактическое попадание противоречащих документов в контекст.")}</p>
      </section>
      <section id="variables"><p class="eyebrow">04 / {txt("Experimental Variables", "Переменные эксперимента")}</p><h2>{txt("Change one factor. Record the others.", "Менять фактор. Фиксировать остальные.")}</h2><div class="table-wrap"><table><thead><tr><th>{txt("Variable", "Переменная")}</th><th>{txt("Planned conditions", "Планируемые условия")}</th></tr></thead><tbody>{project.variables.map(variable => <tr><td>{variable.name[l]}</td><td>{variable.levels[l]}</td></tr>)}</tbody></table></div><p>{txt("Pilot target: approximately 2,000–3,000 generations. Full-study target: tens of thousands of controlled generations across models, scenarios, pressure levels and retrieval conditions. These are planned budgets, not completed runs or a power calculation.", "Ориентир пилота — около 2 000–3 000 генераций. Полное исследование — десятки тысяч контролируемых генераций по моделям, сценариям, уровням давления и retrieval-условиям. Это планируемые объёмы, а не выполненные запуски или расчёт статистической мощности.")}</p></section>
      <section id="evaluation"><p class="eyebrow">05 / {txt("Behavioral Evaluation", "Оценка поведения")}</p><h2>{txt("Evaluate actions and explanations separately.", "Оценивать действия и объяснения отдельно.")}</h2><p class="normative-stage">{txt("All metrics: planned / to be evaluated. No measured values are available on this page.", "Все метрики: планируются / предстоит оценить. Измеренные значения на этой странице пока отсутствуют.")}</p><div class="table-wrap"><table><thead><tr><th>{txt("Core metric", "Основная метрика")}</th><th>{txt("Proposed operational definition", "Предлагаемое операционное определение")}</th></tr></thead><tbody>{project.metrics.map(metric => <tr><td>{metric.name}</td><td>{metric.definition[l]}</td></tr>)}</tbody></table></div><p>{txt("Freeze scoring rubrics and eligible denominators before substantive runs. Report valid-output coverage, per-scenario/model slices and uncertainty for paired contrasts. Account for repeated scenarios when resampling; use independent annotation and adjudication for explanation–action consistency. Estimate normative shifts relative to the control without treating a changed action as automatically better or worse.", "До основных запусков зафиксировать рубрики и допустимые знаменатели. Показать долю валидных ответов, срезы по сценариям/моделям и неопределённость парных сравнений. Учитывать повторение сценариев при resampling; согласованность объяснения и действия размечать независимо с разрешением разногласий. Сдвиг относительно контроля не означает автоматически улучшение или ухудшение решения.")}</p></section>
      <section id="contamination"><p class="eyebrow">06 / {txt("Contamination Experiment", "Эксперимент смешивания корпуса")}</p><h2>{txt("A gradual mixture. An open outcome.", "Постепенное смешивание. Открытый результат.")}</h2><p>{txt("Mix conflicting normative documents into an initially consistent corpus at six planned levels. Record both the corpus-level mixture and the fraction/rank of conflicting chunks actually retrieved for each scenario.", "Добавлять противоречащие нормативные документы в исходно согласованный корпус на шести планируемых уровнях. Для каждого сценария сохранять долю смешивания корпуса, а также долю и позиции противоречащих chunks, реально попавших в retrieval.")}</p><div class="contamination-levels" aria-label={txt("Planned contamination levels", "Планируемые уровни смешивания")}>{[0,10,20,30,40,50].map(level => <div><strong>{level}%</strong><span>{txt("planned", "план")}</span></div>)}</div><p>{txt("Test whether action shifts are gradual or display a nonlinear threshold-like pattern. Define the threshold criterion and analysis before examining outcomes. The six levels may be too coarse to locate a threshold precisely; a phase-transition-like effect remains a hypothesis, not a reported result.", "Проверить, меняются ли действия постепенно или наблюдается нелинейный порогоподобный паттерн. Критерий порога и анализ определить до просмотра результатов. Шесть уровней могут быть слишком грубыми для точного порога; эффект, похожий на фазовый переход, остаётся гипотезой, а не полученным результатом.")}</p><h3>{txt("Possible mitigation studies · later stage", "Возможные способы снижения влияния · следующий этап")}</h3><ul>{project.mitigations.map(item => <li>{item[l]}</li>)}</ul><p class="small muted">{txt("Mitigation effectiveness has not yet been evaluated.", "Эффективность этих подходов пока не оценена.")}</p></section>
      <section id="contributions"><p class="eyebrow">07 / {txt("Expected Contributions", "Ожидаемый вклад")}</p><h2>{txt("A benchmark for normative retrieval influence.", "Бенчмарк нормативного влияния retrieval.")}</h2><ul>{project.contributions.map(item => <li>{item[l]}</li>)}</ul><h3>{txt("Expected outputs · planned", "Ожидаемые результаты · план")}</h3><p>{txt("Scientific paper, open benchmark, scenario dataset, normative RAG corpora, reproducible evaluation framework, open-source code, model comparison report and, if supported by experiments, a mitigation method. No publication acceptance, released benchmark or measured improvement is claimed.", "Научная статья, открытый бенчмарк, набор сценариев, нормативные RAG-корпуса, воспроизводимая система оценки, открытый код, отчёт сравнения моделей и — при подтверждении экспериментами — метод снижения влияния. Принятая публикация, выпущенный бенчмарк и измеренное улучшение пока не заявлены.")}</p><div class="normative-chips">{[...project.tags,"Human–AI Decision Systems","Robustness"].map(tag => <span>{tag}</span>)}</div></section>
      <section id="related"><p class="eyebrow">08 / {txt("Related Research", "Связанные исследования")}</p><h2>{txt("A literature map to complete.", "Карта литературы для дальнейшей проверки.")}</h2><p>{txt("The cards below are reference TODOs, not publications. Direct bibliographic sources for these topics were not available in the repository or supplied brief. Add authors, exact title, venue, year and original-source link only after verification.", "Карточки ниже — reference TODO, а не публикации. Прямых библиографических источников по этим темам нет в репозитории и присланном описании. Авторы, точное название, площадка, год и ссылка на первоисточник добавляются только после проверки.")}</p><div class="normative-reference-grid">{project.relatedTopics.map((topic,i) => <article class="normative-reference-todo"><span class="meta">TODO / REFERENCE 0{i+1}</span><h3>{topic.topic[l]}</h3><p>{topic.role[l]}</p><span class="small muted">{txt("Bibliographic reference pending verification", "Библиографический источник ожидает проверки")}</span></article>)}</div>
        <article class="paper" id="ref-adjacent"><div class="meta">{txt("Adjacent evidence · existing repository reference", "Смежная работа · источник из репозитория")} · {adjacentReference.year}</div><h3 class="paper-title"><a href={adjacentReference.url}>{adjacentReference.title}</a></h3><p class="meta">{adjacentReference.authors} · {adjacentReference.venue}</p><p>{txt("This human–AI study motivates separating recommendation acceptance from decision correctness. It is adjacent evidence about explanations and team behavior, not a study of normative RAG or proof of the proposed research gap.", "Это Human–AI исследование мотивирует раздельную оценку принятия рекомендации и корректности решения. Оно относится к объяснениям и поведению команды, но не исследует нормативный RAG и не доказывает заявленный исследовательский пробел.")}</p><a class="text-link" href={adjacentReference.url}>{txt("Original source", "Первоисточник")} ↗</a></article>
      </section>
    </div></div>
  </div>
</BaseLayout>
