---
interface Props {
  lang: "en" | "ru";
}

const { lang } = Astro.props;
const labels =
  lang === "ru"
    ? { layer: "GEORISK / INSAR", score: "АНОМАЛИЯ", review: "НУЖНА ПРОВЕРКА", coverage: "ПОКРЫТИЕ" }
    : { layer: "GEORISK / INSAR", score: "ANOMALY", review: "REVIEW NEEDED", coverage: "COVERAGE" };
---

<div class="geo-visual" aria-label={lang === "ru" ? "Схема GeoRisk-мониторинга" : "GeoRisk monitoring illustration"} role="img">
  <div class="visual-head">
    <span class="live-dot"></span>
    <span>{labels.layer}</span>
    <span class="visual-id">S1 / ASC</span>
  </div>
  <svg class="terrain-map" viewBox="0 0 620 360" aria-hidden="true">
    <defs>
      <linearGradient id="terrain" x1="0" y1="0" x2="1" y2="1">
        <stop stop-color="#153a2d" />
        <stop offset="1" stop-color="#081c16" />
      </linearGradient>
      <filter id="glow"><feGaussianBlur stdDeviation="5" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
    </defs>
    <rect width="620" height="360" rx="22" fill="url(#terrain)" />
    <g fill="none" stroke="#9af7c6" stroke-opacity=".12">
      <path d="M-30 60C90 10 140 116 250 70s200-20 410 65" />
      <path d="M-20 96c120-60 210 50 310-10s200 4 370 95" />
      <path d="M-10 148c150-80 230 45 350-20s210 40 310 86" />
      <path d="M-20 210c130-60 220 18 330-20s210 30 350 75" />
      <path d="M-10 274c100-34 180 20 290-12s218 20 380 48" />
      <path d="M58-20c20 90-30 140 8 210s20 120-4 200" />
      <path d="M170-20c-20 80 34 134 10 220s20 124 14 190" />
      <path d="M310-20c-40 100 30 140 5 220s40 120 46 190" />
      <path d="M450-20c-20 100 40 160 10 230s35 100 40 180" />
    </g>
    <path d="m214 102 94-42 105 39-10 83-58 36-104-22-47-48Z" fill="#57dfa0" fill-opacity=".09" stroke="#7effb9" stroke-width="1.5" />
    <path d="m251 126 47-22 62 15 14 43-50 27-62-10-29-28Z" fill="#ffbf69" fill-opacity=".13" stroke="#ffbf69" stroke-opacity=".8" />
    <g fill="#89ffc0" filter="url(#glow)">
      <circle cx="291" cy="146" r="4" />
      <circle cx="328" cy="166" r="3" />
      <circle cx="357" cy="139" r="3" />
    </g>
    <path d="M62 300c68-28 112-8 160-40 50-33 98 23 146-7s87-63 190-47" fill="none" stroke="#75efb0" stroke-width="2" />
    <path d="M62 300c68-28 112-8 160-40 50-33 98 23 146-7s87-63 190-47" fill="none" stroke="#75efb0" stroke-opacity=".18" stroke-width="12" />
    <line x1="0" y1="72" x2="620" y2="260" stroke="#fff" stroke-opacity=".1" stroke-dasharray="6 8" />
  </svg>
  <div class="map-callout">
    <span>{labels.score}</span>
    <strong>0.91</strong>
    <small>{labels.review}</small>
  </div>
  <div class="coverage"><span>{labels.coverage}</span><b>87%</b></div>
</div>
