---
import BaseLayout from "../layouts/BaseLayout.astro";
interface Props { locale: "en" | "ru"; }
const { locale } = Astro.props;
const ru = locale === "ru";
const txt = (en: string, russian: string) => ru ? russian : en;
const app = "https://enterprise.vaislabs.com";
---
<BaseLayout lang={locale} canonicalPath={ru ? "/ru/enterprise" : "/enterprise"} title={txt("VAIS Enterprise — KZ/RU AI evaluation", "VAIS Enterprise — оценка KZ/RU AI")} description={txt("Reproducible benchmarks for KZ/RU RAG, copilots and AI agents.", "Воспроизводимые бенчмарки для KZ/RU RAG, копилотов и AI-агентов.")}>
  <section class="enterprise-hero wrap"><p class="eyebrow">VAIS ENTERPRISE / BENCHMARK INFRASTRUCTURE</p><h1>{txt("Evaluate enterprise AI before it reaches production.", "Оценивайте корпоративный AI до выхода в продакшен.")}</h1><p class="lead">{txt("Reproducible benchmarks for KZ/RU RAG, copilots and AI agents — with citation checks, hallucination tracking and versioned evidence.", "Воспроизводимые бенчмарки для KZ/RU RAG, копилотов и AI-агентов: проверка цитат, отслеживание галлюцинаций и версионированные доказательства.")}</p><div class="enterprise-actions"><a class="button button-accent" href={app}>{txt("Open benchmark", "Открыть бенчмарк")} →</a><a class="enterprise-text-link" href="#method">{txt("Read methodology", "О методологии")} ↓</a></div><p class="product-status">{txt("MVP / public synthetic demo dataset", "MVP / открытый синтетический демонстрационный набор")}</p></section>
  <section class="wrap enterprise-block" aria-labelledby="why"><div><p class="eyebrow">THE PROBLEM</p><h2 id="why">{txt("A test set is not yet an evaluation system.", "Тестовый набор — ещё не система оценки.")}</h2></div><p>{txt("Enterprise teams often rely on a small hand-written set of prompts. That hides regressions, weak evidence, outdated sources and KZ/RU cross-language failures. VAIS Enterprise is an independent evaluation layer: versioned, inspectable and repeatable.", "Корпоративные команды часто опираются на небольшой набор вручную написанных промптов. Так теряются регрессии, слабые доказательства, устаревшие источники и ошибки в KZ/RU-сценариях. VAIS Enterprise — независимый слой оценки: версионированный, проверяемый и повторяемый.")}</p></section>
  <section class="wrap enterprise-cards"><article><span>01</span><h3>{txt("Evidence, not just answers", "Доказательства, а не только ответы")}</h3><p>{txt("Answer correctness, citation correctness and completeness, unsupported claims and refusal when evidence is insufficient.", "Корректность ответа, корректность и полнота цитат, неподтверждённые утверждения и отказ при недостатке доказательств.")}</p></article><article><span>02</span><h3>{txt("KZ/RU context", "KZ/RU-контекст")}</h3><p>{txt("Language consistency and reasoning across Kazakh questions and Russian documents — and in the reverse direction.", "Языковая согласованность и рассуждение между казахскими вопросами и русскими документами — и в обратном направлении.")}</p></article><article><span>03</span><h3>{txt("Immutable comparison", "Неизменяемое сравнение")}</h3><p>{txt("Each run records benchmark and target versions, hashes, timing, results and known limitations. A new execution is a new run.", "Каждый запуск сохраняет версии бенчмарка и цели, хеши, время, результаты и ограничения. Новое выполнение — новый запуск.")}</p></article></section>
  <section class="enterprise-dark" id="method"><div class="wrap enterprise-method"><div><p class="eyebrow">WORKFLOW</p><h2>{txt("A result you can trace.", "Результат, который можно проследить.")}</h2></div><ol><li>{txt("Select a versioned benchmark suite", "Выбрать версионированный набор")}</li><li>{txt("Run an evaluation target", "Запустить цель оценки")}</li><li>{txt("Capture response and cited evidence", "Зафиксировать ответ и цитируемые доказательства")}</li><li>{txt("Calculate transparent metrics", "Рассчитать прозрачные метрики")}</li><li>{txt("Store an immutable snapshot", "Сохранить неизменяемый снимок")}</li></ol></div></section>
  <section class="wrap enterprise-block enterprise-use"><div><p class="eyebrow">RESEARCH FIRST</p><h2>{txt("Designed for teams that need to know what changed.", "Для команд, которым важно знать, что изменилось.")}</h2></div><div><p>{txt("For banks, telecom, legal and compliance teams, public-sector digital teams, RAG/agent builders and research labs. The MVP has no billing, SSO or production deployment automation.", "Для банков, телеком-команд, legal и compliance-подразделений, государственных цифровых команд, создателей RAG/агентов и исследовательских лабораторий. В MVP нет биллинга, SSO и автоматизации продакшен-деплоя.")}</p><a href={app} class="enterprise-text-link">{txt("Explore the live demo", "Открыть живое демо")} →</a></div></section>
  <section class="wrap enterprise-note"><p>{txt("VAIS Enterprise does not certify that an AI system is safe or production-ready. Benchmark results describe performance under the published evaluation protocol.", "VAIS Enterprise не сертифицирует AI-системы как безопасные или готовые к продакшену. Результаты бенчмарка описывают производительность в рамках опубликованного протокола оценки.")}</p></section>
</BaseLayout>
<style>
.enterprise-hero{padding-top:8rem;padding-bottom:6.5rem;max-width:1100px}.enterprise-hero h1{font-size:clamp(3.2rem,7vw,7rem);line-height:.94;letter-spacing:-.07em;max-width:1050px;margin:.8rem 0 1.6rem}.lead{font-size:1.3rem;line-height:1.55;max-width:760px;color:#555061}.enterprise-actions{display:flex;align-items:center;gap:1.5rem;margin-top:2.2rem}.enterprise-text-link{color:#352666;font-weight:700;text-decoration:none;border-bottom:1px solid currentColor;padding-bottom:.2rem}.product-status{margin-top:4rem;color:#736c7d;font-size:.8rem;text-transform:uppercase;letter-spacing:.08em}.enterprise-block{display:grid;grid-template-columns:1fr 1fr;gap:4rem;padding-top:5rem;padding-bottom:5rem;border-top:1px solid #ded9d1}.enterprise-block h2,.enterprise-dark h2{font-size:clamp(2rem,4vw,4rem);line-height:1;letter-spacing:-.05em;margin:.6rem 0}.enterprise-block>p,.enterprise-use p{font-size:1.16rem;line-height:1.65;margin:0;color:#514b58}.enterprise-cards{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #ded9d1}.enterprise-cards article{padding:2rem 2rem 3rem;border-right:1px solid #ded9d1}.enterprise-cards article:last-child{border:0}.enterprise-cards span{color:#b4533b;font-size:.8rem;font-weight:700}.enterprise-cards h3{font-size:1.5rem;line-height:1.1;letter-spacing:-.035em}.enterprise-cards p{line-height:1.6;color:#595365}.enterprise-dark{background:#27213b;color:#fff;margin-top:5rem}.enterprise-method{display:grid;grid-template-columns:1fr 1fr;gap:4rem;padding-top:5rem;padding-bottom:5rem}.enterprise-method .eyebrow{color:#c9baff}.enterprise-method ol{list-style:none;margin:0;padding:0;border-top:1px solid #736a8e}.enterprise-method li{padding:1rem 0;border-bottom:1px solid #736a8e;font-size:1.05rem}.enterprise-method li::before{content:"0" counter(list-item);color:#c9baff;margin-right:1rem}.enterprise-use{padding-bottom:4rem}.enterprise-note{margin-bottom:5rem;padding:1.7rem 2rem;background:#ede9f4;border-left:3px solid #7659c5;max-width:1100px}.enterprise-note p{font-size:1.05rem;line-height:1.55;margin:0;color:#433b55}@media(max-width:720px){.enterprise-hero{padding-top:4rem;padding-bottom:4rem}.enterprise-block,.enterprise-method{grid-template-columns:1fr;gap:1.5rem;padding-top:3rem;padding-bottom:3rem}.enterprise-cards{grid-template-columns:1fr}.enterprise-cards article{border-right:0;border-bottom:1px solid #ded9d1}.enterprise-cards article:last-child{border-bottom:0}.enterprise-actions{align-items:flex-start;flex-direction:column}.enterprise-dark{margin-top:2rem}}
</style>
