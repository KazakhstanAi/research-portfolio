---
interface Props {
  lang: "en" | "ru";
}

const { lang } = Astro.props;
const label = lang === "ru" ? "КОД-СВИТЧ / ЗАПИСЬ 0142" : "CODE-SWITCH / SAMPLE 0142";
---

<div class="speech-visual" aria-label={lang === "ru" ? "Схема анализа казахско-русской речи" : "Kazakh–Russian speech analysis illustration"} role="img">
  <div class="visual-head speech-head">
    <span class="live-dot amber"></span>
    <span>{label}</span>
    <span class="visual-id">00:07.4</span>
  </div>
  <div class="wave" aria-hidden="true">
    {Array.from({ length: 78 }, (_, index) => (
      <i style={`--h:${14 + ((index * 37) % 72)}%;--d:${index * 12}ms`}></i>
    ))}
  </div>
  <div class="transcript">
    <span class="token kz">Бүгін</span>
    <span class="token kz">біз</span>
    <span class="token ru">обсудим</span>
    <span class="token ru">новый</span>
    <span class="token en">research</span>
    <span class="cursor"></span>
  </div>
  <div class="speech-readout">
    <div><span>KK</span><strong>42%</strong></div>
    <div><span>RU</span><strong>46%</strong></div>
    <div><span>EN</span><strong>12%</strong></div>
    <div class="auth"><span>AUTH</span><strong>0.97</strong></div>
  </div>
</div>
