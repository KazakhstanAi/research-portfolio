---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResearchArtwork from "./ResearchArtwork.astro";
import ResearchDirectionArtwork from "./ResearchDirectionArtwork.astro";
import { researchDirections } from "../data/research-directions";
import { references } from "../data/references";
import { voiceReferences } from "../data/voice-references";
interface Props { locale: "en" | "ru"; }
const { locale } = Astro.props;
const ru = locale === "ru";
const txt = (en: string, russian: string) => ru ? russian : en;
const geo = (ru ? "/ru" : "") + "/projects/geoai";
const voice = (ru ? "/ru" : "") + "/projects/voice";
const voiceApp = "https://voice.vaislabs.com";
const enterprise = (ru ? "/ru" : "") + "/enterprise";
const enterpriseApp = "https://enterprise.vaislabs.com";
const programs = Object.entries(researchDirections);
const reading = [
  ...[references[0], references[1], references[3]].map(ref => ({...ref, project: "GeoAI", page: geo})),
  ...[voiceReferences[0], voiceReferences[2], voiceReferences[4]].map(ref => ({...ref, project: "VAIS Voice", page: voice}))
];
---
<BaseLayout lang={locale} canonicalPath={ru ? "/ru" : "/"} title={txt("Vais Research — independent AI research", "Vais Research — независимые AI-исследования")} description={txt("GeoAI, scientific multimodal assessment and adaptive human–AI decisions, alongside VAIS Voice and Enterprise research applications.", "GeoAI, мультимодальная оценка научных презентаций и адаптивные Human–AI решения, а также исследовательские приложения VAIS Voice и Enterprise.")}>
  <section class="lab-intro wrap">
    <div class="intro-kicker"><span class="eyebrow"><span class="square-mark"></span>{txt("Independent AI research", "Независимые AI-исследования")}</span><span class="eyebrow">{txt("Kazakhstan · Central Asia", "Казахстан · Центральная Азия")}</span></div>
    <div class="intro-grid">
      <h1>{txt("A closer look.\nA clearer understanding.", "Разбираться глубже.\nСоздавать полезное.")}</h1>
      <div class="intro-copy"><p>{txt("I study how AI generalizes to new places, modalities and people: cross-site GeoAI, grounded scientific presentations and adaptive human–AI decisions.", "Я исследую перенос AI на новые объекты, модальности и людей: cross-site GeoAI, научные презентации с опорой на источник и адаптивные Human–AI решения.")}</p><div class="intro-actions"><a class="button button-accent" href="#projects">{txt("Explore the research", "Исследовательские проекты")} <span aria-hidden="true">↗</span></a><a class="text-link" href="#reading">{txt("Research and methods", "Исследования и методы")} <span aria-hidden="true">↘</span></a></div></div>
    </div>
  </section>

  <section class="featured wrap" aria-labelledby="featured-title">
    <div class="featured-copy">
      <div class="eyebrow">{txt("In focus / Research proposal", "В фокусе / Исследовательский проект")}</div>
      <h2 id="featured-title">Central Asia<br/>GeoAI</h2>
      <p>{txt("Can a model trained on several tailings facilities transfer to an unseen site? Multimodal satellite monitoring with explicit uncertainty.", "Переносится ли модель с нескольких хвостохранилищ на новый объект? Мультимодальный спутниковый мониторинг с оценкой неопределённости.")}</p>
      <a class="button button-light" href={geo}>{txt("Inside the project", "Подробнее о проекте")} <span aria-hidden="true">↗</span></a>
      <div class="featured-bottom"><span>Sentinel-1 / InSAR / ML</span><span>01 — GEO</span></div>
    </div>
    <div class="featured-art"><ResearchArtwork /><span class="art-caption">{txt("Surface studies / conceptual illustration", "Исследование поверхности / концептуальная графика")}</span></div>
  </section>

  <section class="projects wrap section-space" id="projects">
    <div class="section-heading"><div><p class="eyebrow">{txt("Three ML research directions", "Три направления ML-исследований")}</p><h2>{txt("New sites. New modalities.\nChanging people.", "Новые объекты и модальности.\nМеняющийся человек.")}</h2></div><p>{txt("Three independent studies of generalization, grounded representation and personalized sequential decisions. Methods, hypotheses and implementation status are explicit.", "Три самостоятельных исследования обобщения, представлений с опорой на источник и персонализированных последовательных решений. Методы, гипотезы и статус реализации указаны явно.")}</p></div>
    <div class="project-cards">
      <article class="research-card geo-card">
        <a class="card-art" href={geo} aria-label={txt("Explore Central Asia GeoAI", "Открыть Central Asia GeoAI")}><ResearchArtwork /><span class="art-label">01 / EARTH INTELLIGENCE</span><span class="circle-arrow" aria-hidden="true">↗</span></a>
        <div class="card-meta"><span>{txt("Earth observation", "Спутниковые наблюдения")}</span><span class="status">{txt("Pilot planned", "Планируется пилот")}</span></div>
        <h3><a href={geo}>Central Asia GeoAI</a></h3>
        <p>{txt("Cross-site spatiotemporal learning for tailings deformation monitoring. Compare InSAR-only and multimodal models on unseen facilities, with quality, uncertainty and domain-shift diagnostics. First step: a 3–5-site feasibility pilot.", "Cross-site пространственно-временное обучение для мониторинга хвостохранилищ. Сравнение InSAR и мультимодальных моделей на новых объектах с оценкой качества, неопределённости и domain shift. Первый шаг — пилот на 3–5 объектах.")}</p>
        <div class="project-links"><a class="text-link" href={geo}>{txt("About the project", "О проекте")} ↗</a><span class="app-planned">{txt("Application planned", "Приложение планируется")}</span></div>
      </article>
      {programs.map(([kind, project], i) => <article class:list={["research-card", kind + "-card"]}>
        <a class="card-art" href={(ru ? "/ru" : "") + "/projects/" + kind} aria-label={project.name}><ResearchDirectionArtwork kind={kind as "multimodal" | "human-ai"} /><span class="art-label">0{i+2} / {project.area}</span><span class="circle-arrow" aria-hidden="true">↗</span></a>
        <div class="card-meta"><span>{kind === "multimodal" ? "Grounded multimodal assessment" : "Adaptive assistance / LinUCB"}</span><span class="status">{txt("Research baseline", "Исследовательский baseline")}</span></div>
        <h3><a href={(ru ? "/ru" : "") + "/projects/" + kind}>{project.name}</a></h3>
        <p>{project.question[ru ? 1 : 0]}</p>
        <p class="small">{project.status[ru ? 1 : 0]} · {txt("Synthetic demo; real-data validation planned.", "Синтетическое демо; проверка на реальных данных планируется.")}</p>
        <div class="project-links"><a class="text-link" href={(ru ? "/ru" : "") + "/projects/" + kind}>{txt("Methods and evidence", "Методы и источники")} ↗</a><a class="text-link" href={project.repo}>GitHub ↗</a></div>
      </article>)}
    </div>
    <p class="illustration-note">{txt("Conceptual graphics. Research hypotheses, synthetic demonstrations and validated results are labelled separately.", "Концептуальная графика. Исследовательские гипотезы, синтетические демонстрации и подтверждённые результаты обозначены отдельно.")}</p>
  </section>
  <section class="research-programs wrap section-space" id="applications">
    <div class="section-heading"><div><p class="eyebrow">{txt("Applied projects", "Прикладные проекты")}</p><h2>{txt("Research in practice.", "Исследования в действии.")}</h2></div><p>{txt("VAIS Voice and Enterprise connect regional AI evaluation with versioned evidence and working research interfaces.", "VAIS Voice и Enterprise связывают оценку регионального AI с версионированными источниками и работающими исследовательскими интерфейсами.")}</p></div>
    <div class="project-cards">
      <article class="research-card speech-card">
        <a class="card-art" href={voice} aria-label={txt("Explore VAIS Voice", "Подробнее о VAIS Voice")}><ResearchArtwork kind="speech" /><span class="art-label">02 / AUDIO AUTHENTICITY</span><span class="circle-arrow" aria-hidden="true">↗</span></a>
        <div class="card-meta"><span>Synthetic speech detection</span><span class="status">Research → Product MVP</span></div>
        <h3><a href={voice}>VAIS Voice</a></h3>
        <p>{txt("KZ/RU voice AI research: a benchmark and detector interface, with generation as a research direction. Real detection requires a healthy inference service; real-mode generation is unavailable. Explore versioned evidence and current capability status.", "Исследование KZ/RU voice AI: бенчмарк и интерфейс детектора, генерация — исследовательское направление. Реальная детекция зависит от доступности inference-сервиса; генерация в real mode недоступна. Версионированные источники и текущий статус — в приложении.")}</p>
        <div class="project-links"><a class="text-link" href={voice}>{txt("About the project", "О проекте")} ↗</a><a class="text-link" href={voiceApp}>{txt("Open benchmark", "Открыть бенчмарк")} ↗</a></div>
      </article>
      <article class="research-card enterprise-card">
        <a class="card-art" href={enterprise} aria-label={txt("Explore VAIS Enterprise", "Подробнее о VAIS Enterprise")}><ResearchArtwork kind="enterprise" /><span class="art-label">03 / ENTERPRISE AI EVALUATION</span><span class="circle-arrow" aria-hidden="true">↗</span></a>
        <div class="card-meta"><span>{txt("KZ/RU RAG & agent evaluation", "Оценка KZ/RU RAG и агентов")}</span><span class="status">{txt("Benchmark MVP", "MVP бенчмарка")}</span></div>
        <h3><a href={enterprise}>VAIS Enterprise</a></h3>
        <p>{txt("Evaluate enterprise AI before it reaches production. Reproducible KZ/RU benchmarks for RAG, copilots and AI agents, with citation checks, versioned evidence and run comparison. Explore the synthetic demo dataset.", "Оценивайте корпоративный AI до выхода в продакшен. Воспроизводимые KZ/RU-бенчмарки для RAG, копилотов и AI-агентов: проверка цитат, версии источников и сравнение запусков. Начните с синтетического демонабора.")}</p>
        <div class="project-links"><a class="text-link" href={enterprise}>{txt("About the project", "О проекте")} ↗</a><a class="text-link" href={enterpriseApp}>{txt("Open benchmark", "Открыть бенчмарк")} ↗</a></div>
      </article>
    </div>
    <p class="illustration-note">{txt("Graphics are conceptual illustrations, not satellite measurements, audio recordings or benchmark results. Project status is shown on each card.", "Графика — концептуальные иллюстрации, не спутниковые измерения, записи речи или результаты бенчмарка. Статус указан в каждой карточке.")}</p>
  </section>

  <section class="reading-section" id="reading">
    <div class="wrap section-space">
      <div class="section-heading"><div><p class="eyebrow">{txt("The research behind the research", "Научная основа")}</p><h2>{txt("Start with the evidence.", "Начинать с доказательств.")}</h2></div><div class="source-links"><a class="text-link" href={geo+"#evidence"}>GeoAI ↗</a><a class="text-link" href={voice+"#evidence"}>VAIS Voice ↗</a><a class="text-link" href={enterprise+"#evidence"}>VAIS Enterprise ↗</a></div></div>
      <div class="reading-grid">{reading.map((ref,i)=><a class="reading-card" href={ref.page+"#ref-"+ref.id}><div class="reading-top"><span>0{i+1} / {ref.project} / {ref.year}</span><span aria-hidden="true">↗</span></div><span class="reading-type">{ref.type[ru ? 1 : 0]}</span><h3>{ref.title}</h3><p>{ref.authors}</p><span class="reading-venue">{ref.venue}</span></a>)}</div>
      <div class="program-reading reading-grid">{programs.flatMap(([kind, project]) => project.references.slice(0,2).map(ref => <a class="reading-card" href={(ru ? "/ru" : "") + "/projects/" + kind + "#ref-" + ref.id}><div class="reading-top"><span>{project.name} / {ref.year}</span><span aria-hidden="true">↗</span></div><span class="reading-type">{ref.type[ru ? 1 : 0]}</span><h3>{ref.title}</h3><p>{ref.authors}</p><span class="reading-venue">{ref.venue}</span></a>))}</div>
      <div class="enterprise-reading reading-grid">
        {[
          [txt("Published evaluation protocol", "Протокол оценки"), txt("How the demo evaluates answers and citations, and where its limits are.", "Как демонабор оценивает ответы и цитаты и какие ограничения есть у метода."), "#method"],
          [txt("KZ/RU demo dataset", "Демонстрационный KZ/RU-набор"), txt("Twelve synthetic cases, version conflicts and cross-language evidence.", "Двенадцать синтетических кейсов, конфликты версий и межъязыковые доказательства."), "#evidence"],
          [txt("Reproducible snapshots", "Воспроизводимые снимки"), txt("Benchmark versions, source hashes and per-case results.", "Версии бенчмарка, хеши источников и результаты по каждому кейсу."), "#reproducibility"]
        ].map(([title, description, anchor], i) => <a class="reading-card" href={enterprise + anchor}><div class="reading-top"><span>0{i+7} / VAIS Enterprise / v0.1</span><span aria-hidden="true">↗</span></div><span class="reading-type">{txt("Project methodology", "Методология проекта")}</span><h3>{title}</h3><p>{description}</p><span class="reading-venue">VAIS Enterprise</span></a>)}
      </div>
      <p class="illustration-note">{txt("Research cards lead to annotated external papers. Enterprise cards describe the demo protocol and dataset. Project protocols and publication targets are separate from published scientific work.", "Исследовательские карточки ведут к внешним статьям с комментариями. Карточки Enterprise описывают демопротокол и данные. Собственные протоколы и публикационные цели отделены от опубликованных научных работ.")}</p>
    </div>
  </section>

  <section class="about-section" id="about">
    <div class="wrap about-grid">
      <div><p class="eyebrow">{txt("About Vais Research", "О Vais Research")}</p><h2>{txt("Built on curiosity.\nGrounded in context.", "Из любопытства.\nС опорой на контекст.")}</h2><a class="button button-light" href="https://github.com/MataVsn">{txt("My GitHub", "Мой GitHub")} ↗</a></div>
      <div class="about-copy"><p>{txt("Vais Research is my personal research portfolio. I study models that must generalize to new geographic sites, combine scientific text with slides and speech, and adapt assistance to changing people. Regional voice and enterprise projects bring the same attention to local context and reproducibility.", "Vais Research — моё личное исследовательское портфолио. Я изучаю модели, которые должны переноситься на новые географические объекты, объединять научный текст со слайдами и речью и адаптировать помощь к меняющемуся человеку. Региональные voice- и enterprise-проекты сохраняют внимание к локальному контексту и воспроизводимости.")}</p><p>{txt("I start with small experiments and clear comparisons. This is where I will share the methods, results and lessons — including when a simpler model works better.", "Начинаю с небольших экспериментов и понятных сравнений. Здесь будут появляться методы, результаты и выводы — в том числе когда простая модель окажется лучше сложной.")}</p><div class="about-principles"><span>{txt("Local context", "Локальный контекст")}</span><span>{txt("Reproducibility", "Воспроизводимость")}</span><span>{txt("Honest evaluation", "Честная оценка")}</span></div></div>
    </div>
  </section>
</BaseLayout>
