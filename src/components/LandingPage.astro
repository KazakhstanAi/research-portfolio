---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResearchArtwork from "./ResearchArtwork.astro";
import { references } from "../data/references";
interface Props { locale: "en" | "ru"; }
const { locale } = Astro.props;
const ru = locale === "ru";
const txt = (en: string, russian: string) => ru ? russian : en;
const geo = (ru ? "/ru" : "") + "/projects/geoai";
const reading = [references[0], references[1], references[3]];
---
<BaseLayout lang={locale} canonicalPath={ru ? "/ru" : "/"} title={txt("Vais Research — independent AI research", "Vais Research — независимые AI-исследования")} description={txt("Independent research in satellite monitoring for Kazakhstan and Kazakh–Russian speech technology.", "Личное портфолио исследований: спутниковый мониторинг Казахстана и казахско-русские речевые технологии.")}>
  <section class="lab-intro wrap">
    <div class="intro-kicker"><span class="eyebrow"><span class="square-mark"></span>{txt("Independent AI research", "Независимые AI-исследования")}</span><span class="eyebrow">{txt("Kazakhstan · Central Asia", "Казахстан · Центральная Азия")}</span></div>
    <div class="intro-grid">
      <h1>{txt("A closer look.\nA clearer understanding.", "Разбираться глубже.\nСоздавать полезное.")}</h1>
      <div class="intro-copy"><p>{txt("I explore how AI can help us read a changing landscape and understand the languages we speak.", "Я исследую, как AI помогает замечать изменения ландшафта и понимать речь, на которой мы общаемся.")}</p><a class="text-link" href="#projects">{txt("Explore the research", "Исследовательские проекты")} <span aria-hidden="true">↘</span></a></div>
    </div>
  </section>

  <section class="featured wrap" aria-labelledby="featured-title">
    <div class="featured-copy">
      <div class="eyebrow">{txt("In focus / Research proposal", "В фокусе / Исследовательский проект")}</div>
      <h2 id="featured-title">Central Asia<br/>GeoAI</h2>
      <p>{txt("Reading the movement of the ground. A geospatial platform, starting with satellite monitoring of tailings facilities.", "Наблюдать за движением земли. Геопространственная платформа, первый модуль которой — спутниковый мониторинг хвостохранилищ.")}</p>
      <a class="button button-light" href={geo}>{txt("Inside the project", "Подробнее о проекте")} <span aria-hidden="true">↗</span></a>
      <div class="featured-bottom"><span>Sentinel-1 / InSAR / ML</span><span>01 — GEO</span></div>
    </div>
    <div class="featured-art"><ResearchArtwork /><span class="art-caption">{txt("Surface studies / conceptual illustration", "Исследование поверхности / концептуальная графика")}</span></div>
  </section>

  <section class="projects wrap section-space" id="projects">
    <div class="section-heading"><div><p class="eyebrow">{txt("Research directions", "Направления исследований")}</p><h2>{txt("Two questions.\nA shared curiosity.", "Два направления.\nОдин интерес к сложному.")}</h2></div><p>{txt("Independent projects connected by a focus on local data, testable methods and real-world limitations.", "Самостоятельные проекты с общим подходом: локальные данные, проверяемые методы и внимание к ограничениям.")}</p></div>
    <div class="project-cards">
      <article class="research-card geo-card">
        <a class="card-art" href={geo} aria-label={txt("Explore Central Asia GeoAI", "Открыть Central Asia GeoAI")}><ResearchArtwork /><span class="art-label">01 / EARTH INTELLIGENCE</span><span class="circle-arrow" aria-hidden="true">↗</span></a>
        <div class="card-meta"><span>{txt("Earth observation", "Спутниковые наблюдения")}</span><span class="status">{txt("Pilot planned", "Планируется пилот")}</span></div>
        <h3><a href={geo}>Central Asia GeoAI</a></h3>
        <p>{txt("Can deformation time series help identify facilities that need engineering attention? First, a feasibility study on 3–5 sites in Kazakhstan.", "Могут ли временные ряды деформаций выявлять объекты, которым нужна инженерная проверка? Первый шаг — оценка реализуемости на 3–5 объектах Казахстана.")}</p>
        <a class="text-link" href={geo}>{txt("Methods, literature and pilot", "Методы, литература и пилот")} ↗</a>
      </article>
      <article class="research-card speech-card">
        <div class="card-art"><ResearchArtwork kind="speech" /><span class="art-label">02 / SPEECH INTELLIGENCE</span></div>
        <div class="card-meta"><span>{txt("Speech technology", "Речевые технологии")}</span><span class="status">{txt("Concept", "Концепция")}</span></div>
        <h3>Kazakh–Russian Speech</h3>
        <p>{txt("Understanding speech that moves between two languages. Code-switching ASR and synthetic-voice detection, with a focus on errors and robustness.", "Понимать речь, которая переходит с одного языка на другой. Code-switching ASR и обнаружение синтетического голоса с вниманием к ошибкам и устойчивости.")}</p>
        <a class="text-link" href="https://github.com/KazakhstanAi/kazakh-russian-speech-intelligence">{txt("Research repository", "Исследовательский репозиторий")} ↗</a>
      </article>
    </div>
    <p class="illustration-note">{txt("Graphics are conceptual illustrations, not satellite measurements or audio recordings. Both projects are at the research stage.", "Графика — концептуальные иллюстрации, не спутниковые измерения и не записи речи. Оба проекта на исследовательской стадии.")}</p>
  </section>

  <section class="reading-section" id="reading">
    <div class="wrap section-space">
      <div class="section-heading"><div><p class="eyebrow">{txt("The research behind the research", "Научная основа")}</p><h2>{txt("Start with the evidence.", "Начинать с доказательств.")}</h2></div><a class="text-link" href={geo+"#evidence"}>{txt("All sources and comments", "Все источники и комментарии")} ↗</a></div>
      <div class="reading-grid">{reading.map((ref,i)=><a class="reading-card" href={geo+"#ref-"+ref.id}><div class="reading-top"><span>0{i+1} / {ref.year}</span><span aria-hidden="true">↗</span></div><span class="reading-type">{ref.type[ru ? 1 : 0]}</span><h3>{ref.title}</h3><p>{ref.authors}</p><span class="reading-venue">{ref.venue}</span></a>)}</div>
      <p class="illustration-note">{txt("Selected external publications, not papers authored by Vais Research. Annotations distinguish established findings from open questions.", "Избранные внешние публикации, не собственные работы Vais Research. В комментариях отделяю выводы авторов от открытых вопросов проекта.")}</p>
    </div>
  </section>

  <section class="about-section" id="about">
    <div class="wrap about-grid">
      <div><p class="eyebrow">{txt("About Vais Research", "О Vais Research")}</p><h2>{txt("Built on curiosity.\nGrounded in context.", "Из любопытства.\nС опорой на контекст.")}</h2><a class="button button-light" href="https://github.com/MataVsn">{txt("My GitHub", "Мой GitHub")} ↗</a></div>
      <div class="about-copy"><p>{txt("Vais Research is my personal research portfolio. I am interested in problems where the specifics matter: the seasonality of satellite observations, facilities in Kazakhstan and mixed Kazakh–Russian speech.", "Vais Research — моё личное исследовательское портфолио. Мне интересны задачи, где важны детали: сезонность спутниковых наблюдений, особенности объектов Казахстана и смешанная казахско-русская речь.")}</p><p>{txt("I start with small experiments and clear comparisons. This is where I will share the methods, results and lessons — including when a simpler model works better.", "Начинаю с небольших экспериментов и понятных сравнений. Здесь будут появляться методы, результаты и выводы — в том числе когда простая модель окажется лучше сложной.")}</p><div class="about-principles"><span>{txt("Local context", "Локальный контекст")}</span><span>{txt("Reproducibility", "Воспроизводимость")}</span><span>{txt("Honest evaluation", "Честная оценка")}</span></div></div>
    </div>
  </section>
</BaseLayout>
