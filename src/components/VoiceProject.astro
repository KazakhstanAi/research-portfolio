---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResearchArtwork from "./ResearchArtwork.astro";
import { voiceReferences } from "../data/voice-references";
interface Props { locale: "en" | "ru"; }
const { locale } = Astro.props;
const ru = locale === "ru";
const txt = (en: string, russian: string) => ru ? russian : en;
const repo = "https://github.com/KazakhstanAi/kazakh-russian-speech-intelligence";
const sections = [["platform",txt("Platform", "Платформа")],["modules",txt("Modules", "Модули")],["mvp",txt("First MVP", "Первый MVP")],["evaluation",txt("Evaluation", "Оценка")],["evidence",txt("Scientific basis", "Научная основа")],["roadmap",txt("Roadmap", "План развития")],["limits",txt("Responsible use", "Ограничения")]];
const modules = [
  ["VAIS VoiceBench",txt("Scenario-driven voice-agent tests across languages, personas, noise, accents, interruptions and edge cases. Task, intent, tool, latency and policy checks.","Сценарное тестирование voice agents: языки, персоны, шум, акценты, перебивания и пограничные случаи. Проверки задач, intent, инструментов, задержки и правил.")],
  ["VoiceGuard",txt("A separate research layer for synthetic/deepfake and replay audio screening, with tested thresholds, uncertainty and human review.","Отдельный исследовательский слой обнаружения synthetic/deepfake и replay-аудио: проверенные пороги, неопределённость и проверка человеком.")],
  ["Speech Intelligence",txt("STT, language identification, diarization, code-switch detection, transcripts, intents and agent errors. TTS intelligibility and local pronunciation evaluation.","STT, language identification, diarization, code-switch detection, расшифровка, intent и ошибки агента. Оценка разборчивости TTS и произношения локальных слов.")],
  ["Continuous Evaluation",txt("Repeatable comparisons between agent versions and CI regression gates. Production monitoring and enterprise integrations follow after the pilot.","Воспроизводимое сравнение версий агента и CI-проверки регрессий. Production-мониторинг и enterprise-интеграции — после пилота.")]
];
const metrics = [
 ["Task completion",txt("Goal reached, verified against sandbox state; failed calls remain in the denominator.","Достижение цели по состоянию sandbox; неудачные звонки остаются в знаменателе.")],
 [txt("Kazakh / Russian speech", "Казахская / русская речь"),txt("Separate WER/CER against human references, plus intent and local-entity checks.","Отдельные WER/CER по человеческой разметке, проверки intent и локальных сущностей.")],
 ["Code-switching",txt("Switch-span errors, token language-ID F1 and entity exact match; not a single undefined accuracy score.","Ошибки на участках переключения, token language-ID F1 и точное совпадение сущностей; не одна неопределённая accuracy.")],
 ["P95 latency",txt("From user-turn end to first audible agent response, with channel settings and timeouts reported.","От конца реплики пользователя до первого слышимого ответа; настройки канала и таймауты указываются отдельно.")],
 ["Tool-call success",txt("Correct tool, arguments and mock state transition; additional unsafe calls are reported separately.","Правильный инструмент, аргументы и изменение mock-состояния; лишние опасные вызовы учитываются отдельно.")],
 ["Interruption recovery",txt("Correct workflow resumption and response to the interruption; stop latency is a separate metric.","Возврат к правильному шагу и реакция на перебивание; задержка остановки — отдельная метрика.")],
 ["Policy / critical failures",txt("Counts against declared rules and severity; unsupported claims checked against scenario evidence.","Число нарушений заданных правил и критичность; неподтверждённые утверждения сверяются с данными сценария.")],
 ["STT / TTS quality",txt("Transcription errors, native-speaker intelligibility and pronunciation ratings; acoustic metrics are supplementary.","Ошибки транскрипции, оценки разборчивости и произношения носителями; акустические метрики вспомогательны.")],
 ["VoiceGuard score",txt("Separate EER, fixed-threshold FPR/FNR and calibration across attacks and channels; no automatic fraud verdict.","Отдельно EER, FPR/FNR на фиксированном пороге и калибровка по атакам и каналам; без автоматического вердикта о мошенничестве.")]
];
---
<BaseLayout lang={locale} canonicalPath={(ru ? "/ru" : "") + "/projects/voice"} title="VAIS Voice — Vais Research" description={txt("A planned evaluation, security and observability platform for Kazakh–Russian voice AI. VoiceBench, VoiceGuard, speech intelligence and continuous evaluation.","VAIS Voice — проект платформы тестирования, безопасности и мониторинга голосовых AI-систем для казахско-русской среды.")}>
<div class="wrap voice-project">
  <div class="project-hero">
    <a class="text-link" href={(ru ? "/ru" : "/") + "#projects"}>← {txt("All projects", "Все проекты")}</a>
    <h1>VAIS Voice</h1>
    <p class="lead">{txt("Quality, security and observability for voice AI that speaks Kazakh, Russian — and both together.","Качество, безопасность и мониторинг голосового AI, который говорит по-казахски, по-русски — и на обоих языках сразу.")}</p>
    <div class="project-meta"><span>VOICE AI / EVALUATION & SECURITY</span><span>{txt("Platform design", "Проектирование платформы")}</span><span>{txt("MVP target: 100 test calls", "Цель MVP: 100 тестовых звонков")}</span></div>
  </div>
  <figure class="project-cover voice-cover"><ResearchArtwork kind="speech" /><figcaption><span>KZ / RU / CODE-SWITCHING</span><span>{txt("Conceptual illustration · not a recorded call", "Концептуальная графика · не запись звонка")}</span></figcaption></figure>
  <div class="project-overview"><div><span>{txt("Core", "Основа")}</span><strong>VAIS Voice Benchmark</strong></div><div><span>{txt("Evaluation", "Оценка")}</span><strong>Agent + STT / TTS</strong></div><div><span>{txt("Security", "Безопасность")}</span><strong>Synthetic / replay audio</strong></div><div><span>{txt("Status", "Статус")}</span><strong>{txt("Research scaffold", "Исследовательский каркас")}</strong></div></div>
  <div class="article-grid">
    <nav class="toc" aria-label={txt("On this page", "На этой странице")}>{sections.map(([id,label])=><a href={"#"+id}>{label}</a>)}<a href={repo}>{txt("Repository", "Репозиторий")} ↗</a></nav>
    <div class="article">
      <section id="platform">
        <p class="eyebrow">01 / {txt("The platform", "Платформа")}</p><h2>{txt("Test the conversation.\nNot just the transcript.","Проверять разговор.\nНе только расшифровку.")}</h2>
        <p>{txt("VAIS Voice is a planned platform for testing, protecting and monitoring voice AI in Kazakhstan and Central Asia. The goal is to test agent versions before deployment, evaluate STT/TTS and code-switching, analyse dialogue quality, screen synthetic audio and eventually monitor production regressions.","VAIS Voice — проект платформы тестирования, защиты и мониторинга голосового AI в Казахстане и Центральной Азии. Цель — проверять версии агентов до выпуска, оценивать STT/TTS и code-switching, анализировать диалоги, выявлять синтетическое аудио и в дальнейшем отслеживать регрессии в production.")}</p>
        <div class="note"><p>{txt("Current status: research documentation and a Python scaffold. No automated calling service, production dashboard or validated detector is available yet. All platform capabilities on this page are planned.","Текущий статус: исследовательская документация и Python-каркас. Сервиса автоматических звонков, production-панели и валидированного детектора пока нет. Все возможности платформы на этой странице — планируемые.")}</p></div>
        <h3>{txt("Local context is part of the test", "Локальный контекст — часть теста")}</h3>
        <p>{txt("Kazakh and Russian, language switches within a dialogue, local names and addresses, numbers and tenge amounts, banking terminology, regional speech, telephone compression, noise and interruptions form the intended benchmark coverage.","Казахский и русский, переключение языка внутри диалога, локальные имена и адреса, числа и суммы в тенге, банковские термины, региональная речь, телефонная компрессия, шум и перебивания — планируемое покрытие benchmark.")}</p>
        <p>{txt("Initial target users are banks and fintechs, telecoms, insurers, contact centres, voice-agent developers and public services. Their agents could connect for independent evaluation; VAIS Voice is not intended to replace them. These are target segments, not existing clients.","Первый фокус — банки и финтех, телеком, страхование, контакт-центры, разработчики voice agents и государственные сервисы. Их агенты смогут подключаться для независимой оценки: VAIS Voice не предполагает их замену. Это целевые сегменты, не существующие клиенты.")}</p>
      </section>
      <section id="modules"><p class="eyebrow">02 / {txt("Planned modules", "Планируемые модули")}</p><h2>{txt("One platform. Four layers.","Одна платформа. Четыре слоя.")}</h2>
        <div class="voice-modules">{modules.map(([name,desc],i)=><article><span class="eyebrow">0{i+1}</span><h3>{name}</h3><p>{desc}</p></article>)}</div>
        <p class="small muted">{txt("VAIS VoiceBench is our working module name. The independent academic VoiceBench by Chen et al. is a research reference, not our product or an affiliated project.","VAIS VoiceBench — рабочее имя нашего модуля. Независимый академический VoiceBench авторов Chen et al. — научный источник, а не наш продукт или связанный проект.")} <a href="#ref-voicebench">[3]</a></p>
      </section>
      <section id="mvp"><p class="eyebrow">03 / {txt("First deliverable", "Первый результат")}</p><h2>{txt("Connect an agent.\nRun 100 test calls.","Подключить агента.\nПровести 100 тестовых звонков.")}</h2>
        <p>{txt("The first MVP targets one authorised sandbox connector and a versioned suite of 100 simulated calls. Larger suites are a later scaling objective, not a current capacity claim.","Первый MVP — один коннектор к разрешённому sandbox и версионированный набор из 100 симулированных звонков. Сотни и тысячи звонков — дальнейшая цель масштабирования, не заявление о текущей мощности.")}</p>
        <ol class="evaluation-flow">{[txt("Agent version + sandbox","Версия агента + sandbox"),txt("100 KZ / RU / mixed scenarios","100 KZ / RU / смешанных сценариев"),txt("Audio, transcript, timings, tool trace","Аудио, расшифровка, тайминги, tool trace"),txt("Regression report + human review","Отчёт о регрессиях + проверка человеком"),"PASS / FAIL / REVIEW"].map(step=><li>{step}</li>)}</ol>
        <p>{txt("Every failed test should include approved audio, transcript, expected and actual behaviour, failure reason and versioned evidence. VoiceGuard adds a separate audio-screening score. Missing evidence is marked for review, not silently passed.","Для каждого неудачного теста: разрешённое аудио, расшифровка, ожидаемое и фактическое поведение, причина ошибки и версии артефактов. VoiceGuard добавляет отдельный score проверки аудио. Недостаток доказательств означает необходимость проверки, а не автоматический PASS.")}</p>
      </section>
      <section id="evaluation"><p class="eyebrow">04 / {txt("Evaluation protocol", "Протокол оценки")}</p><h2>{txt("A report you can inspect.","Отчёт, который можно проверить.")}</h2>
        <div class="table-wrap"><table><thead><tr><th>{txt("Metric", "Метрика")}</th><th>{txt("What is measured", "Что измеряем")}</th></tr></thead><tbody>{metrics.map(([name,desc])=><tr><td>{name}</td><td>{desc}</td></tr>)}</tbody></table></div>
        <p>{txt("Compare agent versions on the same fixtures, repeat stochastic scenarios, publish slice sizes and uncertainty. Keep speakers, scenario templates and derived audio out of both development and protected test partitions. Validate LLM judges against bilingual reviewers.","Сравнивать версии на одинаковых данных, повторять стохастические сценарии, показывать размер срезов и неопределённость. Не допускать пересечения дикторов, шаблонов сценариев и производного аудио между разработкой и защищённым тестом. Проверять LLM-судей по оценкам двуязычных экспертов.")}</p>
        <div class="note"><p>{txt("100 calls demonstrate feasibility, not enterprise safety or precise rare-failure rates. Set gate thresholds before testing; insufficient coverage, judge disagreement and infrastructure failures require REVIEW.","100 звонков демонстрируют реализуемость, а не enterprise-безопасность или точную частоту редких ошибок. Пороги фиксируются до теста; недостаточное покрытие, разногласия оценщиков и сбои инфраструктуры требуют REVIEW.")}</p></div>
      </section>
      <section id="evidence"><p class="eyebrow">05 / {txt("Scientific basis", "Научная основа")}</p><h2>{txt("Why this is worth studying.","Почему это стоит исследовать.")}</h2>
        <p>{txt("These papers support the need for multidimensional evaluation and robust audio testing. They do not establish VAIS Voice performance, business demand or complete Kazakh–Russian coverage.","Эти работы обосновывают многомерную оценку и проверку устойчивости аудиосистем. Они не доказывают эффективность VAIS Voice, рыночный спрос или полноту казахско-русского покрытия.")}</p><p class="reading-date">{txt("Sources checked", "Источники проверены")}: 19.09.2026</p>
        {voiceReferences.map((ref,i)=><article class="paper" id={"ref-"+ref.id}><div class="meta">[{i+1}] {ref.type[ru?1:0]} · {ref.year}</div><h3 class="paper-title"><a href={ref.url}>{ref.title}</a></h3><p class="meta">{ref.authors} · {ref.venue}</p><p><strong>{txt("Finding. ","Результат. ")}</strong>{ref.finding[ru?1:0]}</p><p><strong>{txt("Role and limits. ","Роль и ограничения. ")}</strong>{ref.meaning[ru?1:0]}</p><div class="links"><a href={ref.url}>{txt("Primary source", "Первоисточник")} ↗</a></div></article>)}
      </section>
      <section id="roadmap"><p class="eyebrow">06 / {txt("Research and roadmap", "Исследование и развитие")}</p><h2>{txt("Build the benchmark first.","Сначала — собственный benchmark.")}</h2>
        <p>{txt("The proposed long-term asset is a governed VAIS Voice Benchmark: local scenarios, reviewed annotations and realistic failure cases. Its value must be measured by coverage, reproducibility and ability to catch held-out regressions. It is not an existing released dataset.","Предполагаемый долгосрочный актив — VAIS Voice Benchmark: локальные сценарии, проверенная разметка и реалистичные случаи ошибок. Ценность нужно измерить покрытием, воспроизводимостью и обнаружением регрессий на отложенных данных. Это не существующий опубликованный датасет.")}</p>
        <ul><li>{txt("Weeks 1–4: governance, scenario taxonomy, bilingual references and sandbox contract.","Недели 1–4: правила работы с данными, типология сценариев, двуязычная разметка и контракт sandbox.")}</li><li>{txt("Weeks 5–8: one connector, 100-call runner, inspectable reports, STT/TTS baselines and separate VoiceGuard evaluation.","Недели 5–8: один коннектор, 100-call runner, проверяемые отчёты, STT/TTS baseline и отдельная оценка VoiceGuard.")}</li><li>{txt("Weeks 9–12: paired regressions, judge audits, unseen-condition tests and a restricted demo, subject to data and integration readiness.","Недели 9–12: парное сравнение регрессий, аудит оценщиков, новые условия и ограниченное демо — при готовности данных и интеграции.")}</li></ul>
        <p>{txt("Later: production observability, policy/compliance workflows, model and vendor comparisons, CI/CD integration and on-premises deployment. These require further implementation and review.","Далее: production-мониторинг, процессы проверки правил и compliance, сравнение моделей и поставщиков, CI/CD и on-prem. Эти возможности требуют дальнейшей реализации и проверки.")}</p>
      </section>
      <section id="limits"><p class="eyebrow">07 / {txt("Responsible use", "Ответственное использование")}</p><h2>{txt("Useful signals. Clear boundaries.","Полезные сигналы. Явные границы.")}</h2>
        <p>{txt("Test only authorised systems with approved voices, mocked transactions and strict call/cost limits. Do not contact real customers or reuse production recordings without separate authorisation and governance. Keep sensitive evidence access-controlled and redact exports.","Тестировать только разрешённые системы с разрешёнными голосами, mock-транзакциями и лимитами звонков и затрат. Не звонить реальным клиентам и не использовать production-записи без отдельного разрешения и правил обработки. Ограничивать доступ к чувствительным данным и обезличивать выгрузки.")}</p>
        <p>{txt("Synthetic speech is not inherently fraud. VoiceGuard must not be the sole basis for identity decisions or service denial. A score needs local calibration before it can be interpreted as a probability. Policy checks are not legal certification, and LLM judges can be wrong.","Синтетическая речь сама по себе не означает мошенничество. VoiceGuard не должен единолично определять личность или отказ в обслуживании. Для интерпретации score как вероятности нужна локальная калибровка. Проверки правил не являются юридической сертификацией, а LLM-судьи могут ошибаться.")}</p>
        <a class="text-link" href={repo}>{txt("Platform plan and evaluation protocol on GitHub", "План платформы и протокол оценки на GitHub")} ↗</a>
      </section>
    </div>
  </div>
</div>
</BaseLayout>
