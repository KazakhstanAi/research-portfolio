---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResearchArtwork from "./ResearchArtwork.astro";
import { voiceReferences } from "../data/voice-references";
interface Props { locale: "en" | "ru"; }
const { locale } = Astro.props;
const ru = locale === "ru";
const txt = (en: string, russian: string) => ru ? russian : en;
const repo = "https://github.com/KazakhstanAi/kazakh-russian-speech-intelligence";
const sections = [["purpose",txt("Purpose", "Задача")],["architecture",txt("Architecture", "Архитектура")],["mvp",txt("First MVP", "Первый MVP")],["evaluation",txt("Evaluation", "Протокол оценки")],["evidence",txt("Scientific basis", "Научная основа")],["roadmap",txt("Roadmap", "Развитие")],["limits",txt("Responsible use", "Ограничения")]];
const components = [
 ["Detection Model",txt("Real vs synthetic speech, evaluated separately on Kazakh, Russian and mixed KZ/RU speech.","Real vs synthetic speech с отдельной оценкой на казахской, русской и смешанной KZ/RU-речи.")],
 ["Robustness",txt("Held-out TTS and voice-cloning generators, codecs, noise and repeated transcoding.","Отложенные TTS и voice-cloning генераторы, кодеки, шум и повторное перекодирование.")],
 ["Benchmark",txt("A protected real/synthetic corpus and reproducible evaluation. R&D infrastructure, not a separate product.","Защищённый real/synthetic корпус и воспроизводимая оценка. Инфраструктура R&D, не отдельный продукт.")]
];
const metrics = [
 ["ROC-AUC",txt("Ranking genuine vs synthetic speech across thresholds; synthetic is the positive class.","Разделение реальной и синтетической речи по всем порогам; положительный класс — synthetic.")],
 ["EER",txt("The point where false-positive and false-negative rates are equal; not necessarily the deployment threshold.","Точка равных false-positive и false-negative rates; не обязательно рабочий порог сервиса.")],
 ["FPR@TPR95",txt("Genuine speech incorrectly flagged at a threshold detecting 95% of synthetic samples. Report ROC interpolation; also freeze a development threshold and report actual held-out TPR/FPR.","Доля реальной речи, ошибочно отмеченной при обнаружении 95% synthetic. Указывать интерполяцию ROC; дополнительно фиксировать порог на development и показывать фактические TPR/FPR на тесте.")],
 ["Calibration",txt("Reliability diagrams, Brier score and ECE on held-out data, with class prevalence and sample counts. Calibration may not transfer to new domains.","Reliability diagrams, Brier score и ECE на отложенных данных с частотой классов и размером выборки. Калибровка может не переноситься на новые домены.")],
 ["Unseen-generator",txt("TTS / voice-cloning families and versions absent from training and calibration.","Семейства и версии TTS / voice-cloning, отсутствующие в обучении и калибровке.")],
 ["Codec robustness",txt("MP3, Opus, AAC, telephone-like compression and repeated encoding, applied comparably to both classes.","MP3, Opus, AAC, телефонное сжатие и повторное кодирование, сопоставимо применённые к обоим классам.")],
 ["Noise robustness",txt("Microphone and background noise, re-recording, duration and signal-quality slices.","Микрофонный и фоновый шум, перезапись, срезы по длительности и качеству сигнала.")],
 ["Language slices",txt("KZ, RU and KZ↔RU separately, with sample counts and uncertainty intervals.","Отдельно KZ, RU и KZ↔RU, с числом примеров и интервалами неопределённости.")],
 ["Cross-speaker",txt("No speaker, source recording or synthetic derivative leakage between protected splits; an evaluation constraint, not a scalar metric.","Без утечки дикторов, исходных записей и синтетических производных между выборками; условие протокола, не скалярная метрика.")]
];
---
<BaseLayout lang={locale} canonicalPath={(ru ? "/ru" : "") + "/projects/voice"} title="VAIS Voice — Synthetic Speech Authenticity" description={txt("Synthetic speech detection for Kazakh–Russian environments. Research on unseen generators, real audio channels and calibrated scores; a planned audio-upload API and web prototype.","VAIS Voice — обнаружение синтетической речи в KZ/RU-среде: новые генераторы, реальные аудиоканалы, проверяемые метрики и будущий web/API-прототип.")}>
<div class="wrap voice-project">
  <div class="project-hero">
    <a class="text-link" href={(ru ? "/ru" : "/") + "#projects"}>← {txt("All projects", "Все проекты")}</a>
    <h1>VAIS Voice</h1>
    <p class="eyebrow">Synthetic Speech Authenticity for Kazakh–Russian Environments</p>
    <p class="lead">{txt("Detecting synthetic speech in Kazakh–Russian environments — with verifiable metrics and tests against unseen generators and real audio channels.","Определение синтетической речи в казахско-русской среде — с проверяемыми метриками и проверкой устойчивости к новым генераторам и реальным аудиоканалам.")}</p>
    <div class="project-meta"><span>VOICE AI / AUDIO AUTHENTICITY</span><span>Research → Product MVP</span><span>KZ / RU / CODE-SWITCHING</span><span>REAL / SYNTHETIC SPEECH</span></div>
  </div>
  <figure class="project-cover voice-cover"><ResearchArtwork kind="speech" /><figcaption><span>AUDIO AUTHENTICITY</span><span>{txt("Conceptual illustration · not a recorded sample", "Концептуальная графика · не реальная запись")}</span></figcaption></figure>
  <div class="project-overview"><div><span>{txt("Task", "Задача")}</span><strong>Synthetic speech detection</strong></div><div><span>{txt("Research", "Исследование")}</span><strong>KZ/RU Anti-Spoofing Benchmark</strong></div><div><span>MVP</span><strong>Upload audio → score</strong></div><div><span>{txt("Status", "Статус")}</span><strong>{txt("Research prototype — planned", "Research prototype — в разработке концепции")}</strong></div></div>
  <div class="article-grid">
    <nav class="toc" aria-label={txt("On this page", "На этой странице")}>{sections.map(([id,label])=><a href={"#"+id}>{label}</a>)}<a href={repo}>{txt("Repository", "Репозиторий")} ↗</a></nav>
    <div class="article">
      <section id="purpose"><p class="eyebrow">01 / {txt("Purpose", "Задача")}</p><h2>{txt("Investigate the voice.\nNot just how it sounds.","Проверять происхождение голоса.\nНе угадывать по звучанию.")}</h2>
        <p>{txt("VAIS Voice is a research project and future API for synthetic speech detection in Kazakh, Russian and mixed KZ/RU speech. The intended output is a score reflecting similarity to synthetic speech, accompanied by signal quality, model version and assessment uncertainty.","VAIS Voice — исследовательский проект и будущий API для обнаружения синтетической речи в казахской, русской и смешанной KZ/RU-речи. Планируемый результат — score, отражающий сходство с синтетической речью, вместе с качеством сигнала, версией модели и неопределённостью оценки.")}</p>
        <p>{txt("The first focus is short voice messages and recordings processed through real codecs and communication channels. The research tests transfer to unseen TTS and voice-cloning models, languages, compression and noise. Detection does not identify the speaker or prove the recording's origin.","Первый фокус — короткие голосовые сообщения и записи, прошедшие через реальные кодеки и каналы связи. Исследование проверяет перенос на новые TTS и voice-cloning модели, языки, compression и шум. Детекция не устанавливает личность диктора и не доказывает происхождение записи.")}</p>
        <div class="note"><p>{txt("Current repository: research design and Python scaffold, not a trained detector or live inference service. The prototype and metrics described here are planned; no validated KZ/RU results have been published.","Сейчас в репозитории — исследовательский план и Python-каркас, не обученный детектор и не работающий inference-сервис. Прототип и метрики на этой странице планируются; валидированных KZ/RU-результатов пока нет.")}</p></div>
      </section>
      <section id="architecture"><p class="eyebrow">02 / {txt("Architecture", "Архитектура")}</p><h2>{txt("One task.\nA traceable pipeline.","Одна задача.\nПрослеживаемый процесс.")}</h2>
        <ol class="evaluation-flow">{["Audio", "Preprocessing", "Language / channel metadata", "Synthetic speech detector", "Calibration", "Authenticity report / score", "API / Web demo"].map(step=><li>{step}</li>)}</ol>
        <p>{txt("Validate and decode audio, record duration and channel information, then run the versioned detector. Language and channel metadata may be supplied, inferred or unknown; never present an estimate as verified. Apply a calibrator fitted only on development data, or clearly label the output as uncalibrated. Unsupported inputs should return an inconclusive result.","Проверить и декодировать аудио, сохранить длительность и сведения о канале, затем запустить версионированный детектор. Язык и канал могут быть предоставлены, оценены или неизвестны: оценка не должна выглядеть как подтверждённый факт. Калибратор обучается только на development-данных; иначе результат помечается как некалиброванный. Неподдерживаемые данные должны давать неопределённый результат.")}</p>
        <div class="voice-modules">{components.map(([name,desc],i)=><article><span class="eyebrow">0{i+1}</span><h3>{name}</h3><p>{desc}</p></article>)}</div>
      </section>
      <section id="mvp"><p class="eyebrow">03 / {txt("First MVP", "Первый MVP")}</p><h2>{txt("Upload audio.\nInspect the authenticity score.","Загрузить аудио.\nПолучить измеримый authenticity score.")}</h2>
        <p>{txt("The planned MVP accepts a short .wav, .mp3, .ogg or .opus file and returns a synthetic-speech score, calibration status and technical audio information. It does not issue a binary legally significant verdict. Duration and size limits will be fixed during profiling.","Планируемый MVP принимает короткий .wav, .mp3, .ogg или .opus файл и возвращает synthetic speech score, статус калибровки и технические сведения об аудио. Это не бинарный юридически значимый вердикт. Ограничения длительности и размера фиксируются после профилирования.")}</p>
        <figure class="auth-report" aria-label={txt("Illustrative report mockup", "Иллюстративный макет отчёта")}>
          <figcaption><strong>VOICE AUTHENTICITY REPORT</strong><span>{txt("STATIC MOCKUP · NOT A MODEL RESULT", "СТАТИЧЕСКИЙ МАКЕТ · НЕ РЕЗУЛЬТАТ МОДЕЛИ")}</span></figcaption>
          <dl><div><dt>File</dt><dd>voice_message.ogg</dd></div><div><dt>Language</dt><dd>{txt("Kazakh / Russian mixed · example label", "Kazakh / Russian mixed · пример метаданных")}</dd></div></dl>
          <div class="auth-score"><span>Synthetic speech score</span><strong>0.87</strong><span>{txt("Illustrative value only · higher = more synthetic-like", "Только пример · выше = больше сходства с synthetic")}</span></div>
          <dl><div><dt>Calibration / confidence</dt><dd>{txt("Not assessed in this mockup", "Не оценены в макете")}</dd></div><div><dt>Audio quality</dt><dd>{txt("Acceptable · example label", "Acceptable · пример статуса")}</dd></div><div><dt>Model</dt><dd>VAIS-VA v0.1 · {txt("proposed name", "планируемое имя")}</dd></div><div><dt>Channel</dt><dd>Opus-compressed · {txt("example", "пример")}</dd></div></dl>
          <button type="button" class="button" disabled>{txt("Analyze another file", "Проанализировать другой файл")} ↗</button><p class="small">{txt("Interface preview only. Upload and analysis are not enabled; no audio is sent anywhere.","Только пример интерфейса. Загрузка и анализ не включены; аудио никуда не отправляется.")}</p>
        </figure>
        <p class="small muted">{txt("A high raw score is not automatically high confidence. Confidence or probability requires a defined method and evidence for the relevant language, channel and population.","Высокий raw score не означает высокую уверенность. Confidence или вероятность требуют определённого метода и проверки на соответствующем языке, канале и выборке.")}</p>
      </section>
      <section id="evaluation"><p class="eyebrow">04 / {txt("Evaluation protocol", "Протокол оценки")}</p><h2>{txt("Measure what transfers.","Измерять то, что переносится.")}</h2>
        <div class="table-wrap"><table><thead><tr><th>{txt("Metric / test", "Метрика / проверка")}</th><th>{txt("What it establishes", "Что проверяем")}</th></tr></thead><tbody>{metrics.map(([name,desc])=><tr><td>{name}</td><td>{desc}</td></tr>)}</tbody></table></div>
        <p>{txt("Freeze data splits, preprocessing, model selection and calibration before protected testing. Keep synthetic derivatives with their source and prevent generator-family leakage into unseen-generator evaluation. Match channels across genuine and synthetic classes so a detector cannot win by recognising file format. Report abstention and rejected-input rates alongside metrics.","Зафиксировать выборки, препроцессинг, выбор модели и калибровку до защищённого теста. Синтетические производные хранить в той же группе, что источник; исключить утечку семейств генераторов в unseen-generator тест. Сопоставить каналы real и synthetic, чтобы детектор не распознавал формат файла вместо синтеза. Вместе с метриками показывать долю отказов от оценки и отклонённых входов.")}</p>
      </section>
      <section id="evidence"><p class="eyebrow">05 / {txt("Scientific basis", "Научная основа")}</p><h2>{txt("Detection, generalization,\nand the limits of a score.","Детекция, переносимость\nи границы оценки.")}</h2>
        <p>{txt("The central sources concern audio deepfake detection and cross-domain evaluation. KSC2 provides local speech context; NISQA is only a supporting quality-control reference. None demonstrates VAIS Voice performance.","Центральные источники посвящены audio deepfake detection и оценке переноса между доменами. KSC2 даёт контекст локальной речи; NISQA — только вспомогательный контроль качества. Ни одна работа не доказывает эффективность VAIS Voice.")}</p><p class="reading-date">{txt("Sources checked", "Источники проверены")}: 19.09.2026</p>
        {voiceReferences.map((ref,i)=><article class="paper" id={"ref-"+ref.id}><div class="meta">[{i+1}] {ref.type[ru?1:0]} · {ref.year}</div><h3 class="paper-title"><a href={ref.url}>{ref.title}</a></h3><p class="meta">{ref.authors} · {ref.venue}</p><p><strong>{txt("Finding. ","Результат. ")}</strong>{ref.finding[ru?1:0]}</p><p><strong>{txt("Role and limits. ","Роль и ограничения. ")}</strong>{ref.meaning[ru?1:0]}</p><div class="links"><a href={ref.url}>{txt("Primary source", "Первоисточник")} ↗</a></div></article>)}
      </section>
      <section id="roadmap"><p class="eyebrow">06 / {txt("Research and development", "Исследование и развитие")}</p><h2>{txt("Research → Product MVP", "Исследование → продуктовый MVP")}</h2>
        <ul><li>{txt("Weeks 1–4: licensed genuine/synthetic corpus, leakage-safe speaker and generator splits, baseline models and a reproducible benchmark.","Недели 1–4: лицензированный real/synthetic корпус, выборки без speaker/generator leakage, baseline-модели и воспроизводимый benchmark.")}</li><li>{txt("Weeks 5–8: KZ/RU slices, unseen generators, codecs/noise and calibration; choose the MVP model on development evidence.","Недели 5–8: KZ/RU-срезы, unseen generators, codecs/noise и calibration; выбор модели для MVP по development-данным.")}</li><li>{txt("Weeks 9–12: upload → inference → score web/API prototype, a public benchmark report and restricted demo, subject to data and model readiness.","Недели 9–12: web/API-прототип upload → inference → score, публичный benchmark report и ограниченное demo — при готовности данных и модели.")}</li></ul>
        <p>{txt("Later: streaming inference, batch API, enterprise and on-premises deployment, additional anti-spoofing scenarios and integrations. Replay detection is not an established capability of the first real/synthetic model.","Далее: streaming inference, batch API, enterprise и on-prem, дополнительные anti-spoofing сценарии и интеграции. Replay detection не считается доказанной возможностью первой real/synthetic модели.")}</p>
      </section>
      <section id="limits"><p class="eyebrow">07 / Responsible use</p><h2>{txt("A signal. Not an accusation.","Сигнал. Не обвинение.")}</h2>
        <p>{txt("Synthetic speech is not inherently malicious. A synthetic score is not proof of fraud, not a probability that a particular person is an attacker, and not identity verification. It must not independently determine denial of service or other high-impact decisions.","Синтетическая речь сама по себе не означает злой умысел. Synthetic score не доказывает мошенничество, не является вероятностью того, что конкретный человек — злоумышленник, и не подтверждает личность. Он не должен единолично определять отказ в обслуживании или иные значимые решения.")}</p>
        <p>{txt("Analyse only audio with appropriate rights and consent. Restrict raw recordings, define retention and deletion, do not reuse uploads for training by default, and sandbox untrusted media decoding. Unsupported channels or poor signals require an inconclusive response, not invented confidence.","Анализировать только аудио с необходимыми правами и согласием. Ограничить доступ к записям, определить сроки хранения и удаления, не использовать загрузки для обучения по умолчанию и изолировать декодирование недоверенных файлов. Неподдерживаемый канал или плохой сигнал требуют неопределённого результата, не выдуманной уверенности.")}</p>
        <a class="text-link" href={repo}>{txt("Research plan and evaluation protocol on GitHub", "Исследовательский план и протокол оценки на GitHub")} ↗</a>
      </section>
    </div>
  </div>
</div>
</BaseLayout>
