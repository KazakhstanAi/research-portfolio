---
interface Props { kind?: "terrain" | "speech"; }
const { kind = "terrain" } = Astro.props;
// Original editorial illustrations, not satellite observations or recorded audio.
const contours = Array.from({length: 48}, (_, i) => {
  const scale = 25 + i * 9;
  return Array.from({length: 161}, (_, j) => {
    const a = j / 160 * Math.PI * 2;
    const r = scale * (1 + .12 * Math.sin(a * 3 + i * .018) + .09 * Math.cos(a * 5) + .045 * Math.sin(a * 8));
    return `${j ? "L" : "M"}${(350 + Math.cos(a) * r * 1.12).toFixed(2)},${(290 + Math.sin(a) * r * .72).toFixed(2)}`;
  }).join(" ") + "Z";
});
const waves = Array.from({length: 96}, (_, i) => {
  const envelope = Math.exp(-Math.pow((i-25)/14,2)) + .8*Math.exp(-Math.pow((i-68)/12,2));
  return {x: 28+i*6.8, height: 12 + envelope*(80+100*Math.abs(Math.sin(i*1.72)))};
});
---
<svg class:list={["research-art", kind]} viewBox="0 0 700 560" preserveAspectRatio="xMidYMid slice" fill="none" aria-hidden="true" focusable="false">
  {kind === "terrain" ? <>
    <rect width="700" height="560" fill="#c5694a" />
    <g stroke="#482e28" stroke-width="1.1" opacity=".8">{contours.map(d => <path d={d} />)}</g>
    <g stroke="#f4d4b6" stroke-width="1" opacity=".8">
      <path d="M0 140H700M0 420H700M175 0V560M525 0V560" stroke-dasharray="2 8" />
      <path d="M327 290H373M350 267V313M54 48H80M67 35V61M620 499H646M633 486V512" />
      <circle cx="350" cy="290" r="8" />
    </g>
    <path d="M40 510H130M40 505V515M130 505V515" stroke="#482e28" stroke-width="2" />
  </> : <>
    <rect width="700" height="560" fill="#d8dce8" />
    <g stroke="#9ca6bd" stroke-width="1">{[100,190,280,370,460].map(y=><path d={`M0 ${y}H700`} />)}</g>
    <g stroke="#414f79" stroke-width="3.5">{waves.map(w=><path d={`M${w.x} ${280-w.height}V${280+w.height}`} />)}</g>
    <path d="M350 65V495" stroke="#f6f4ed" stroke-width="2" stroke-dasharray="6 6" />
    <g fill="#414f79" font-family="Arial,sans-serif" font-size="18"><text x="40" y="58">ҚАЗ</text><text x="607" y="518">РУС</text></g>
  </>}
</svg>
